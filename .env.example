# Environment Variables
# Copy this file to .env.local and fill in values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Website Bisnis Tralis"

# Database (jika menggunakan database)
# DATABASE_URL=postgresql://username:password@localhost:5432/tralis_db

# Authentication (jika menggunakan NextAuth)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# Email (jika menggunakan email service)
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your@email.com
# EMAIL_SERVER_PASSWORD=your-password
# EMAIL_FROM=noreply@yourdomain.com

# Analytics (jika menggunakan Google Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# API Keys
# NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-api-key
